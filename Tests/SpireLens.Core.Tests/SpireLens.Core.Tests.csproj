<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\Sts2PathDiscovery.props"/>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\SpireLens.Core.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <Sts2LibDir Condition="'$(Sts2DataDir)' != '' and Exists('$(Sts2DataDir)')">$(Sts2DataDir)</Sts2LibDir>
        <Sts2LibDir Condition="'$(Sts2LibDir)' == ''">$(MSBuildThisFileDirectory)../../lib</Sts2LibDir>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(Sts2LibDir)/0Harmony.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2LibDir)/sts2.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="GodotSharp">
            <HintPath>$(Sts2LibDir)/GodotSharp.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="*" />
        <PackageReference Include="xunit" Version="*" />
        <PackageReference Include="xunit.runner.visualstudio" Version="*" />
    </ItemGroup>
</Project>
