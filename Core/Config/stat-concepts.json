{
  "schema_version": 1,
  "concepts": {
    "activation": {
      "display": {
        "type": "styled_text",
        "value": "A",
        "color": "#F4C95D",
        "bold": true,
        "size": 20
      },
      "help": {
        "label": "Activation",
        "description": "An activation occurs when an effect successfully triggers."
      }
    },
    "average": {
      "display": {
        "type": "styled_text",
        "value": "x̄",
        "color": "#8FD3FF",
        "bold": true,
        "size": 20
      },
      "help": {
        "label": "Average",
        "description": "A mean value: the total divided by the relevant number of turns, combats, floors, or activations."
      }
    },
    "card": {
      "display": {
        "type": "game_resource",
        "path": "res://images/ui/reward_screen/reward_icon_card.png",
        "size": 20
      },
      "help": {
        "label": "Card",
        "description": "A card or a count of cards."
      }
    },
    "charge": {
      "display": {
        "type": "styled_text",
        "value": "●³",
        "color": "#7FD6FF",
        "bold": true,
        "size": 20
      },
      "help": {
        "label": "Charge",
        "description": "A stored charge accumulated or used by a relic."
      }
    },
    "combat": {
      "display": {
        "type": "game_resource",
        "path": "res://images/atlases/ui_atlas.sprites/map/icons/map_monster.tres",
        "size": 20
      },
      "help": {
        "label": "Combat",
        "description": "A combat encounter or a value measured across combats."
      }
    },
    "floor": {
      "display": {
        "type": "game_resource",
        "path": "res://images/atlases/ui_atlas.sprites/top_bar/top_bar_floor.tres",
        "size": 20
      },
      "help": {
        "label": "Floor",
        "description": "A run floor or a value measured across floors."
      }
    },
    "healing_blocked": {
      "display": {
        "type": "game_resource_group",
        "resources": [
          {
            "path": "res://images/atlases/ui_atlas.sprites/top_bar/top_bar_heart.tres",
            "scale": 1.0
          },
          {
            "path": "res://images/ui/combat/block.png",
            "scale": 0.65
          }
        ],
        "size": 20
      },
      "help": {
        "label": "Healing blocked",
        "description": "Healing that was attempted but did not restore HP."
      }
    },
    "healing_gained": {
      "display": {
        "type": "game_resource",
        "path": "res://images/atlases/power_atlas.sprites/regen_power.tres",
        "size": 20
      },
      "help": {
        "label": "Healing gained",
        "description": "HP successfully restored by a healing effect."
      }
    },
    "osty_summon_gained": {
      "display": {
        "type": "game_resource",
        "path": "res://images/atlases/relic_atlas.sprites/bound_phylactery.tres",
