      "help": {
        "label": "Turn",
        "description": "A combat turn or a value measured across turns."
      }
    },
    "upgraded": {
      "display": {
        "type": "game_resource",
        "path": "res://images/ui/cards/upgrade_preview/upgrade_arrow.png",
        "size": 20
