      },
      "help": {
        "label": "Osty summon gained",
        "description": "An increase to Osty's summon amount."
      }
    },
    "turn": {
      "display": {
        "type": "styled_text",
        "value": "↻",
        "color": "#7FE0C3",
        "bold": true,
        "size": 20
